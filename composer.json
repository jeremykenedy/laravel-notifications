{
    "name": "jeremykenedy/laravel-notifications",
    "description": "A Laravel package providing an in-app notification center with bell/badge UI, read/unread tracking, and REST API.",
    "keywords": ["laravel", "notifications", "bell", "badge", "in-app", "center"],
    "license": "MIT",
    "type": "library",
    "authors": [{"name": "Jeremy Kenedy", "email": "jeremykenedy@gmail.com"}],
    "require": {
        "php": "^8.2|^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/notifications": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0"
    },
    "autoload": { "psr-4": { "Jeremykenedy\\LaravelNotifications\\": "src/" } },
    "autoload-dev": { "psr-4": { "Jeremykenedy\\LaravelNotifications\\Tests\\": "tests/" } },
    "extra": { "laravel": { "providers": ["Jeremykenedy\\LaravelNotifications\\Providers\\NotificationServiceProvider"] } },
    "config": { "sort-packages": true, "allow-plugins": { "pestphp/pest-plugin": true } },
    "minimum-stability": "stable",
    "prefer-stable": true
}
