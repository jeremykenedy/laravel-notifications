<?xml version="1.0"?>
<ruleset name="laravel-notifications"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>PHPMD tuned for a Laravel package. The checks stay on, with exceptions for Laravel idioms.</description>

    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*.blade.php</exclude-pattern>

    <rule ref="rulesets/cleancode.xml">
        <!-- Public API: send(..., bool $sendEmail) cannot change without breaking callers. -->
        <exclude name="BooleanArgumentFlag"/>
        <!-- Configured below. -->
        <exclude name="StaticAccess"/>
    </rule>

    <!-- Facades and the package's own pure static helpers are static by design. -->
    <rule ref="rulesets/cleancode.xml/StaticAccess">
        <properties>
            <property name="exceptions" value="\Illuminate\Support\Facades\Auth,\Illuminate\Support\Facades\Event,\Illuminate\Support\Facades\Notification,\Illuminate\Support\Facades\Route,\Illuminate\Support\Facades\Schema,\Livewire\Livewire,\Jeremykenedy\LaravelNotifications\Support\Colors,\Jeremykenedy\LaravelNotifications\Support\Frameworks"/>
        </properties>
    </rule>

    <rule ref="rulesets/codesize.xml">
        <exclude name="TooManyPublicMethods"/>
    </rule>

    <!-- One public method per action is how these controllers and the service are meant to read. -->
    <rule ref="rulesets/codesize.xml/TooManyPublicMethods">
        <properties>
            <property name="maxmethods" value="15"/>
        </properties>
    </rule>

    <rule ref="rulesets/design.xml"/>

    <rule ref="rulesets/naming.xml">
        <exclude name="ShortVariable"/>
    </rule>

    <!-- $id is the route parameter name, so it cannot be renamed without changing public signatures. -->
    <rule ref="rulesets/naming.xml/ShortVariable">
        <properties>
            <property name="exceptions" value="id"/>
        </properties>
    </rule>

    <rule ref="rulesets/unusedcode.xml">
        <!-- Laravel's notification contract passes $notifiable to via(), toMail() and toArray(). -->
        <exclude name="UnusedFormalParameter"/>
    </rule>
</ruleset>
