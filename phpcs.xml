<?xml version="1.0"?>
<ruleset name="laravel-notifications">
    <description>PSR-12, with the two sniffs the Laravel code style deliberately departs from.</description>

    <file>src</file>
    <file>config</file>
    <file>routes</file>
    <file>database</file>
    <file>tests</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>

    <exclude-pattern>*.blade.php</exclude-pattern>
    <exclude-pattern>/vendor/*</exclude-pattern>

    <rule ref="PSR12">
        <!-- Laravel writes concatenation without spaces: 'a'.$b -->
        <exclude name="PSR12.Operators.OperatorSpacing"/>
        <!-- Laravel migrations are written as: new class() extends Migration -->
        <exclude name="PSR12.Classes.AnonClassDeclaration"/>
    </rule>

    <!-- Pest test descriptions are sentences, so line length is not enforced there. -->
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>/tests/*</exclude-pattern>
    </rule>

    <!-- Pest test files declare helpers and register tests in the same file. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>/tests/*</exclude-pattern>
    </rule>
</ruleset>
